[connection]
id=windows-profile
uuid=windows-profile
type=wifi
autoconnect=false
autoconnect-priority=-999
autoconnect-retries=1
mdns=0
llmnr=0

[wifi]
mode=infrastructure
mac-address=a0:29:42:8c:8e:ad
mac-address-randomization=default
powersave=2

[wifi-security]
key-mgmt=wpa-psk
psk=

[ipv4]
method=auto
dhcp-hostname=desktop-369dn1d
dhcp-client-id=01:a0:29:42:8c:8e:ad
dhcp-vendor-class-identifier=msft 5.0
ignore-auto-dns=no
dns-priority=0

[ipv6]
method=disabled